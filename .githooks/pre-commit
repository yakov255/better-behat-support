#!/bin/sh
# Regenerate docs/updatePlugins.xml when CHANGELOG.md changes

if git diff --cached --name-only --diff-filter=ACM | grep -q '^CHANGELOG\.md$'; then
  echo "CHANGELOG.md changed — regenerating docs/updatePlugins.xml..."
  ./gradlew generateUpdatePluginsXml --quiet
  git add docs/updatePlugins.xml
fi
